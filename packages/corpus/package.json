{
  "name": "@perseus/corpus",
  "version": "0.1.0",
  "private": true,
  "description": "Word lists and quotes in pt-BR and English, plus a seeded text generator.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:content": "pnpm build && node scripts/content-review.mjs",
    "check:snippets": "pnpm build && node snippet-check/run.mjs"
  },
  "dependencies": {
    "@perseus/contracts": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
