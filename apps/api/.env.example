# PERSEUSS API
#
# Copie para .env e preencha. Sem nada preenchido a API sobe, serve /health e
# pontua corrida do mesmo jeito — o ranking e o histórico é que se declaram
# desligados. O treinador nunca dependeu de nenhum dos dois.

PORT=3001

# Postgres: o duelo, o ranking e a identidade, todos. Uma conexão só, comum.
# Sem ela o duelo roda de ponta a ponta — a sala vive na memória da API — e o
# que falta é tudo que sobrevive à sala.
#   local: postgresql://postgres:perseus@localhost:5432/perseus
#   Neon:  postgresql://...@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Se negocia TLS com esse banco. false para Postgres no mesmo host; true para
# qualquer coisa que o tráfego saia da máquina para alcançar.
DATABASE_SSL=false

# Separadas por vírgula. Adicione a origem do site antes de ir ao ar.
CORS_ORIGINS=http://localhost:3000

# Assina os bilhetes de corrida, os tokens de duelo e os passaportes do ranking.
# Qualquer string longa e aleatória; `openssl rand -hex 32` serve.
#
# **Obrigatória para o ranking existir.** Sem ela o processo assina com um
# segredo que inventa no boot, e um passaporte assinado assim seria revogado
# pelo próximo deploy, em silêncio, para todo mundo — então a identidade se
# declara indisponível em vez de funcionar até lá. Bilhete e duelo continuam
# funcionando, porque os dois duram minutos.
RUN_TICKET_SECRET=

# Quantos proxies estão na frente da API. O rate limit conta chamador por
# endereço, e atrás de um balanceador todo chamador é o balanceador.
TRUST_PROXY_HOPS=0

# Teto do corpo. Uma timeline de corrida longa de código dá uns 90 KB, e o
# padrão do Express é 100 KB.
MAX_BODY_SIZE=512kb
