# PERSEUS API
#
# Copy to .env and fill in. Without the Supabase pair the API still boots and
# still serves /health — results sync and the leaderboard simply report
# themselves as unavailable, which is what the web app checks before offering
# sign-in.

PORT=3001

# Supabase → Project Settings → API.
# The SERVICE ROLE key bypasses row-level security. It belongs here and nowhere
# else: never in apps/web, never in anything prefixed NEXT_PUBLIC_, never in a
# commit. If it leaks, rotate it in the dashboard immediately.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres, for the duel history. Optional and separate from Supabase: a duel
# has no accounts and no row-level policies, so it needs a plain connection and
# nothing else. Without this, duels still run end to end — the room lives in the
# API's memory — and finished ones simply are not written down.
#   local:  postgresql://postgres:perseus@localhost:5432/perseus
#   on the VM: postgresql://perseus:SENHA@127.0.0.1:5432/perseus
DATABASE_URL=

# Whether to negotiate TLS to that database. Leave false for Postgres on the
# same host; true when the traffic leaves the box.
DATABASE_SSL=false

# Comma separated. Add the deployed web origin before going live.
CORS_ORIGINS=http://localhost:3000

# Signs the run tickets a run is opened with and the tokens that say which side
# of a duel somebody is playing. Any long random
# string; `openssl rand -hex 32` will do. Optional: without it the process signs
# with a secret it invents at boot, which works locally and means a restart
# refuses every run somebody had open. Required once more than one instance runs.
RUN_TICKET_SECRET=

# How many proxies sit in front of the API. Rate limiting counts callers by
# address, and behind a load balancer every caller is the balancer until this
# says how far back to look.
TRUST_PROXY_HOPS=0

# Ceiling on a request body. A keystroke timeline for a long code run is around
# 90 KB, and Express defaults to 100 KB.
MAX_BODY_SIZE=512kb
