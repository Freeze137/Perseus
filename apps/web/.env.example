# PERSEUSS web
#
# Tudo aqui é NEXT_PUBLIC_ e portanto público: vai dentro do bundle. Nada aqui é
# segredo, e isso deixou de ser uma precaução para virar um fato — o site não
# tem mais credencial de banco nenhuma. Ele fala com a API, e só.
#
# Vazio, o treinador funciona exatamente como funciona hoje: offline, com os
# resultados medidos na própria máquina e nada guardado.

# Onde a API que pontua e classifica está.
NEXT_PUBLIC_API_URL=http://localhost:3001

# A origem pública deste deploy, sem barra no fim.
#
# Lida só para URLs absolutas que saem da página: o card do Open Graph que um
# link vira no WhatsApp, e o canonical. Vazia na Vercel, o domínio de produção
# é usado — o que é certo para produção e errado para domínio próprio.
NEXT_PUBLIC_SITE_URL=
