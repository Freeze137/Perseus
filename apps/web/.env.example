# PERSEUS web
#
# Copy to .env.local and fill in. Everything here is NEXT_PUBLIC_ and therefore
# public: it ships inside the JavaScript bundle. Only ever put the ANON key
# here — it is designed to be public and is constrained by the row-level
# security policies in supabase/migrations. The service role key is not.
#
# Left empty, the trainer works exactly as it does today, offline: no sign-in,
# no sync, local results only.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the scoring API lives.
NEXT_PUBLIC_API_URL=http://localhost:3001
